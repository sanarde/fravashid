#: cli/src/main.c:29
#, c-format
msgid "fravashi: cannot connect to the session bus: %s\n"
msgstr "fravashi: не удалось подключиться к сессионной шине: %s\n"

#: cli/src/main.c:40
#, c-format
msgid "fravashi: fravashid does not answer: %s\n"
msgstr "fravashi: fravashid не отвечает: %s\n"

#: cli/src/main.c:126
#, c-format
msgid "usage: fravashi set [-o OUTPUT | -p PROFILE] PATH\n"
msgstr "использование: fravashi set [-o ВЫВОД | -p ПРОФИЛЬ] ПУТЬ\n"

#: cli/src/main.c:130
#, c-format
msgid "fravashi: cannot resolve %s\n"
msgstr "fravashi: не удалось определить путь %s\n"

#: cli/src/main.c:138
#, c-format
msgid "fravashi: cannot open the settings\n"
msgstr "fravashi: не удалось открыть настройки\n"

#: cli/src/main.c:145
#, c-format
msgid "fravashi: cannot save the setting (%d)\n"
msgstr "fravashi: не удалось сохранить настройку (%d)\n"

#: cli/src/main.c:166
#, c-format
msgid "usage: fravashi get | next | prev | set [-o OUTPUT | -p PROFILE] PATH\n"
msgstr "использование: fravashi get | next | prev | set [-o ВЫВОД | -p ПРОФИЛЬ] ПУТЬ\n"
